      "description": "BGP Neighbor IP address"
    },
    "policyType": {
      "type": "string",
      "enum": [
        "import",
        "export"
      ]
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routeAction": {
      "type": "string",
      "enum": [
        "accept",
        "reject"
      ]
    }
  },
  "required": [
