      "description": "Instance name running BFD session"
    },
    "remoteIp": {
      "type": "string",
      "description": "Remote IP"
    },
    "sourceIp": {
      "type": "string",
      "description": "Remote IP"
    },
    "interval": {
      "type": "integer",
