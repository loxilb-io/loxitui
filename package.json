{
  "name": "loxitui",
  "version": "0.1.0",
  "description": "Terminal UI for LoxiLB and the LoxiLB inference gateway, with an optional AI assistant",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/loxilb-io/loxitui.git"
  },
  "type": "module",
  "main": "src/cli.tsx",
  "bin": {
    "loxitui": "src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "dev": "bun --watch run src/cli.tsx",
    "build": "bun build --compile --target=bun src/cli.tsx --outfile dist/loxitui",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64-modern src/cli.tsx --outfile dist/loxitui-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli.tsx --outfile dist/loxitui-linux-arm64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/cli.tsx --outfile dist/loxitui-darwin-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/cli.tsx --outfile dist/loxitui-darwin-x64",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e",
    "test:e2e:testbed": "./scripts/e2e-testbed.sh",
    "lint": "bunx @biomejs/biome check src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentui/core": "0.1.72",
    "@opentui/core-darwin-x64": "0.1.86",
    "@opentui/core-linux-arm64": "0.1.86",
    "@opentui/core-linux-x64": "0.1.86",
    "@opentui/react": "0.1.72",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "handlebars": "^4.7.8",
    "react": "^19.0.0",
    "smol-toml": "^1.3.1",
    "yaml": "^2.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "@biomejs/biome": "^1.9.0"
  },
  "engines": {
    "bun": ">=1.3.6"
  }
}
